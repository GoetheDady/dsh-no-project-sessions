{
  "name": "dsh-no-project-sessions",
  "version": "0.2.0",
  "private": true,
  "description": "No-project sessions with automatically created working directories and a native Recent section",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoetheDady/dsh-no-project-sessions.git"
  },
  "homepage": "https://github.com/GoetheDady/dsh-no-project-sessions#readme",
  "bugs": {
    "url": "https://github.com/GoetheDady/dsh-no-project-sessions/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "market": "node scripts/market.mjs",
    "market:check": "node scripts/market.mjs --check"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
